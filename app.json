{
  "expo": {
    "name": "Rakat",
    "slug": "rakat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rakat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dadama.rakat",
      "supportsTablet": true,
      "appleTeamId": "86F4PU33B4",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.dadama.rakat"
        ]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rakat needs your coordinates once, to calculate prayer times on this phone. They are stored locally and never sent anywhere."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15564A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dadama.rakat"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEEE9",
          "dark": {
            "backgroundColor": "#101413",
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 110
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-updates",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/adhan.wav"
          ],
          "color": "#15564A"
        }
      ],
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.dadama.rakat"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    }
  }
}
